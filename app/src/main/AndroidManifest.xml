<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:sharedUserId="android.uid.system">

    <!--
      この端末の ROM は AOSP の公開テスト鍵で署名されているため、同じ鍵で署名すると
      system UID として動ける。これにより signature レベルの権限がすべて署名だけで
      通り、adb での pm grant も root も不要になる。
      鍵は scripts/fetch-platform-keys.sh、照合結果は README を参照。

      sharedUserId は API 29 で非推奨だが targetSdk 28 では有効。この端末専用アプリ
      なので互換性より特権を優先する。
    -->

    <!--
      WRITE_SECURE_SETTINGS は signature|privileged|development。
      プラットフォーム署名があれば signature で通る。署名が無い環境では
      development フラグにより adb の pm grant でも付与できる。
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Settings.System への書き込みは appop と別に宣言が要る。宣言が無いと canWrite() が false のまま。 -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Android 11 以降 NetworkInterface の列挙が制限されるため、IP は ConnectivityManager から取る。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 端末内 Web 設定画面のサーバソケットを開くために必要。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_showdeck"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.ShowDeck">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize"
            android:theme="@style/Theme.ShowDeck">

            <!--
              HOME + DEFAULT を取ってランチャーそのものになる。
              これによりクラッシュしても強制終了されても必ず画面に戻ってくる。
              常駐をサービスで頑張るより確実で、非力な端末にも優しい。
            -->
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- 開発中は通常のランチャーからも起動できるようにしておく -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".admin.AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
